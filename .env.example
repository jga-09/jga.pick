# ======================================================================
# JGAPicksBot configuration. Copy to .env and fill in. NEVER commit .env.
# ======================================================================

# --- Telegram ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to control the bot
TELEGRAM_ADMIN_IDS=

# --- Kalshi ------------------------------------------------------------
# prod = https://api.elections.kalshi.com/trade-api/v2 ; demo = https://demo-api.kalshi.co/trade-api/v2
KALSHI_ENV=prod
# Easiest: leave both blank and send /setkey to the bot in Telegram (messages are deleted at once,
# the key is saved inside the bot's data volume). Paper trading works without any key.
KALSHI_API_KEY_ID=
# Path to the PEM private key downloaded when you created the API key
KALSHI_PRIVATE_KEY_PATH=
# Request pacing (stay under your Kalshi API tier limits)
KALSHI_READ_RPS=8
KALSHI_WRITE_RPS=4

# Data source: kalshi (real market data) | fixture (synthetic, dry-run only)
DATA_SOURCE=kalshi

# --- Execution mode (PAPER is the default) -----------------------------
PAPER_TRADING=true
LIVE_TRADING=false
AUTO_TRADING=false
# Live auto-trading needs this too (in addition to LIVE_TRADING=true, PAPER_TRADING=false)
ALLOW_LIVE_AUTOTRADE=false

DEFAULT_RISK_LEVEL=low

# --- Paper simulation --------------------------------------------------
PAPER_STARTING_BALANCE=1000
PAPER_SLIPPAGE_CENTS=1
ORDER_PRICE_TOLERANCE_CENTS=2
FEE_RATE=0.07

# --- Market discovery --------------------------------------------------
# STRATEGY_MODE=btc (default) trades Bitcoin 15-minute markets only; ASSETS is ignored in that mode.
ASSETS=BTC
# Optional explicit series tickers (auto-discovery also runs), e.g. KXBTC15M,KXETH15M
SERIES_TICKERS=
AUTO_DISCOVER_SERIES=true
MARKET_DURATION_MINUTES=15
DISCOVERY_INTERVAL_SEC=30

# --- Market data -------------------------------------------------------
POLL_INTERVAL_SEC=5
ORDERBOOK_DEPTH=10
USE_WEBSOCKET=true
STALE_DATA_SEC=30
# Optional underlying spot feed: none | coinbase
UNDERLYING_PROVIDER=none

# --- Signal engine -----------------------------------------------------
SIGNAL_MIN_CONFIDENCE=55
SIGNAL_MIN_HISTORY_SEC=60

# --- Signal quality / research ----------------------------------------
# Distinct settled markets required before any historical statistic is trusted
HIST_MIN_SAMPLES=30
# Edge estimates are shrunk towards zero by this many "prior" markets
CALIBRATION_PRIOR_STRENGTH=20
OBSERVATION_RETENTION_DAYS=365
MODEL_REFRESH_SEC=600
# Optional: override component max points, e.g. {"momentum": 20, "underlying": 15}
#SIGNAL_WEIGHTS={}
# Optional: override StrategyConfig thresholds, e.g. {"vol_high": 1.8, "extended_price": 78}
#STRATEGY_PARAMS={}
# Comma list of no-trade filters to switch off (only after research shows they hurt), e.g. weak_book,flip_flop
DISABLED_FILTERS=
# btc (default) = Bitcoin probability model + net-edge + no-trade engine (see README section 15c)
# quality = legacy multi-asset signal-quality engine | confirm = experimental V4 rule (PAPER ONLY)
STRATEGY_MODE=btc

# --- BTC engine (STRATEGY_MODE=btc) -----------------------------------
# BTC price feed is Coinbase Exchange BTC-USD (public, no key). Block trades when it is older than:
BTC_FEED_STALE_SEC=15
# Uncertainty between Coinbase and Kalshi's settlement index (CF Benchmarks BRTI), basis points
BTC_BASIS_BPS=3
# Minutes of 1-minute returns used for volatility
BTC_SIGMA_WINDOW_MIN=60
# Max seconds between the Kalshi quote and the BTC price used together
MAX_DATA_SKEW_SEC=20
# Never trade a contract whose settlement rules text is missing
REQUIRE_SETTLEMENT_RULES=true
# Max expected calibration error (probability points / 100) before the model counts as calibrated
CALIBRATION_ECE_TOL=0.05
# Written by scripts/btc_backtest.py, shown in Telegram under 🧪 Backtest
BTC_BACKTEST_REPORT=data/btc_backtest_report.json

# --- Telegram UI / alerts ----------------------------------------------
DASHBOARD_REFRESH_SEC=15
ALERT_COOLDOWN_SEC=120
STRONG_SIGNAL_ALERT_MIN_CONFIDENCE=80
LARGE_LOSS_ALERT_USD=5

# --- Persistence / retention -------------------------------------------
DATABASE_URL=sqlite:///data/bot.db
SNAPSHOT_INTERVAL_SEC=30
SNAPSHOT_RETENTION_DAYS=7
SIGNAL_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=30

LOG_LEVEL=INFO
# Start the scanner automatically on launch (useful on a server). Paper mode only.
AUTO_START=false

# --- Risk profiles (defaults shown; every value is bounded by hard limits) ---
LOW_MIN_CONFIDENCE=80
LOW_MAX_POSITION_USD=5
LOW_MAX_OPEN_POSITIONS=1
LOW_MAX_DAILY_LOSS_USD=10
LOW_MIN_TIME_REMAINING_SEC=180
LOW_MAX_SPREAD_CENTS=5

MEDIUM_MIN_CONFIDENCE=70
MEDIUM_MAX_POSITION_USD=15
MEDIUM_MAX_OPEN_POSITIONS=2
MEDIUM_MAX_DAILY_LOSS_USD=30
MEDIUM_MIN_TIME_REMAINING_SEC=120
MEDIUM_MAX_SPREAD_CENTS=8

HIGH_MIN_CONFIDENCE=60
HIGH_MAX_POSITION_USD=30
HIGH_MAX_OPEN_POSITIONS=3
HIGH_MAX_DAILY_LOSS_USD=60
HIGH_MIN_TIME_REMAINING_SEC=60
HIGH_MAX_SPREAD_CENTS=12

# Setup-quality gates (defaults: LOW 85 / A+,A / stability 0.8 / 0 warnings / EV>=3c / EV required,
#                                 MEDIUM 75 / A+,A,B / 0.6 / 1 / 2c / EV required,
#                                 HIGH 65 / A+,A,B / 0.5 / 2 / 1c / paper allowed while data is collected)
#MEDIUM_REQUIRE_KNOWN_EV=false   # let MEDIUM paper-trade before history supports an EV estimate
LOW_MIN_SIGNAL_QUALITY=85
MEDIUM_MIN_SIGNAL_QUALITY=75
HIGH_MIN_SIGNAL_QUALITY=65
#LOW_ALLOWED_GRADES=A+,A
#HIGH_ALLOWED_GRADES=A+,A,B,C
#LOW_MIN_STABILITY=0.8
#LOW_MAX_SOFT_FLAGS=0
#LOW_MIN_EV_CENTS=3
#LOW_REQUIRE_KNOWN_EV=true

# BTC engine per profile (defaults LOW / MEDIUM / HIGH):
#   *_MIN_EV_CENTS              3 / 2 / 1      min conservative net edge per contract after fees+slippage
#   *_MIN_BTC_STRENGTH          55 / 45 / 35   min 0-100 evidence score (not a probability)
#   *_MAX_PROB_WIDTH            0.15/0.20/0.25 widest acceptable model probability range
#   *_BLOCKED_REGIMES           HIGH_VOLATILITY,RAPID_REVERSAL,INSUFFICIENT_DATA / HIGH_VOLATILITY,INSUFFICIENT_DATA / INSUFFICIENT_DATA
#   *_MAX_LATE_MOVE_CENTS       12 / 15 / 20   side already up this much in 5 min -> needs 2x the edge
#   *_MAX_CONSECUTIVE_LOSSES    2 / 3 / 4      then pause for *_STREAK_PAUSE_SEC (3600/2700/1800)
#   *_KELLY_FRACTION            0.10/0.20/0.25 stake cap as a fraction of full Kelly (conservative P)
#   *_REQUIRE_KNOWN_EV          true/true/false  require a calibrated model (live ALWAYS requires it)
# Advanced (optional): *_MAX_TOTAL_EXPOSURE_USD, *_MIN_LIQUIDITY_CONTRACTS,
# *_LOSS_COOLDOWN_SEC, *_TRADE_COOLDOWN_SEC, *_MIN_ENTRY_PRICE_CENTS,
# *_MAX_ENTRY_PRICE_CENTS, *_MAX_BALANCE_FRACTION

# Telegram alerts: false = only trade messages (Trade Taken / Won / Lost) while auto trade is on
SIGNAL_ALERTS=false

# --- Early exit ("cash out" when a trade turns against you) -------------
# Paper sells automatically; real money only gets a Sell button.
EARLY_EXIT=true
# Exit when the signal flips to the other side with at least this confidence (old strategies)
EARLY_EXIT_FLIP_CONFIDENCE=60
# BTC strategy: exit when the bot's odds for your side fall below this
EARLY_EXIT_BTC_P_SIDE=0.40
# The flip must show up this many checks in a row (avoids selling on noise)
EARLY_EXIT_CONFIRM_TICKS=2
# Don't bother selling below this price (cents) or with less than this many seconds left
EARLY_EXIT_MIN_BID_CENTS=5
EARLY_EXIT_MIN_T_LEFT_SEC=45
# Optional stop-loss: sell if the contract's value drops this % below entry (0 = off)
EARLY_EXIT_STOP_LOSS_PCT=0
