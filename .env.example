# ======================================================================
# JGAPicksBot configuration. Copy to .env and fill in. NEVER commit .env.
# ======================================================================

# --- Telegram ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to control the bot
TELEGRAM_ADMIN_IDS=

# --- Kalshi ------------------------------------------------------------
# prod = https://api.elections.kalshi.com/trade-api/v2 ; demo = https://demo-api.kalshi.co/trade-api/v2
KALSHI_ENV=prod
KALSHI_API_KEY_ID=
# Path to the PEM private key downloaded when you created the API key
KALSHI_PRIVATE_KEY_PATH=
# Request pacing (stay under your Kalshi API tier limits)
KALSHI_READ_RPS=8
KALSHI_WRITE_RPS=4

# Data source: kalshi (real market data) | fixture (synthetic, dry-run only)
DATA_SOURCE=kalshi

# --- Execution mode (PAPER is the default) -----------------------------
PAPER_TRADING=true
LIVE_TRADING=false
AUTO_TRADING=false
# Live auto-trading needs this too (in addition to LIVE_TRADING=true, PAPER_TRADING=false)
ALLOW_LIVE_AUTOTRADE=false

DEFAULT_RISK_LEVEL=low

# --- Paper simulation --------------------------------------------------
PAPER_STARTING_BALANCE=1000
PAPER_SLIPPAGE_CENTS=1
ORDER_PRICE_TOLERANCE_CENTS=2
FEE_RATE=0.07

# --- Market discovery --------------------------------------------------
ASSETS=BTC,ETH,SOL
# Optional explicit series tickers (auto-discovery also runs), e.g. KXBTC15M,KXETH15M
SERIES_TICKERS=
AUTO_DISCOVER_SERIES=true
MARKET_DURATION_MINUTES=15
DISCOVERY_INTERVAL_SEC=30

# --- Market data -------------------------------------------------------
POLL_INTERVAL_SEC=5
ORDERBOOK_DEPTH=10
USE_WEBSOCKET=true
STALE_DATA_SEC=30
# Optional underlying spot feed: none | coinbase
UNDERLYING_PROVIDER=none

# --- Signal engine -----------------------------------------------------
SIGNAL_MIN_CONFIDENCE=55
SIGNAL_MIN_HISTORY_SEC=60

# --- Signal quality / research ----------------------------------------
# Distinct settled markets required before any historical statistic is trusted
HIST_MIN_SAMPLES=30
# Edge estimates are shrunk towards zero by this many "prior" markets
CALIBRATION_PRIOR_STRENGTH=20
OBSERVATION_RETENTION_DAYS=365
MODEL_REFRESH_SEC=600
# Optional: override component max points, e.g. {"momentum": 20, "underlying": 15}
#SIGNAL_WEIGHTS={}
# Optional: override StrategyConfig thresholds, e.g. {"vol_high": 1.8, "extended_price": 78}
#STRATEGY_PARAMS={}
# Comma list of no-trade filters to switch off (only after research shows they hurt), e.g. weak_book,flip_flop
DISABLED_FILTERS=

# --- Telegram UI / alerts ----------------------------------------------
DASHBOARD_REFRESH_SEC=15
ALERT_COOLDOWN_SEC=120
STRONG_SIGNAL_ALERT_MIN_CONFIDENCE=80
LARGE_LOSS_ALERT_USD=5

# --- Persistence / retention -------------------------------------------
DATABASE_URL=sqlite:///data/bot.db
SNAPSHOT_INTERVAL_SEC=30
SNAPSHOT_RETENTION_DAYS=7
SIGNAL_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=30

LOG_LEVEL=INFO

# --- Risk profiles (defaults shown; every value is bounded by hard limits) ---
LOW_MIN_CONFIDENCE=80
LOW_MAX_POSITION_USD=5
LOW_MAX_OPEN_POSITIONS=1
LOW_MAX_DAILY_LOSS_USD=10
LOW_MIN_TIME_REMAINING_SEC=180
LOW_MAX_SPREAD_CENTS=5

MEDIUM_MIN_CONFIDENCE=70
MEDIUM_MAX_POSITION_USD=15
MEDIUM_MAX_OPEN_POSITIONS=2
MEDIUM_MAX_DAILY_LOSS_USD=30
MEDIUM_MIN_TIME_REMAINING_SEC=120
MEDIUM_MAX_SPREAD_CENTS=8

HIGH_MIN_CONFIDENCE=60
HIGH_MAX_POSITION_USD=30
HIGH_MAX_OPEN_POSITIONS=3
HIGH_MAX_DAILY_LOSS_USD=60
HIGH_MIN_TIME_REMAINING_SEC=60
HIGH_MAX_SPREAD_CENTS=12

# Setup-quality gates (defaults: LOW 85 / A+,A / stability 0.8 / 0 warnings / EV>=3c / EV required,
#                                 MEDIUM 75 / A+,A,B / 0.6 / 1 / 2c / EV required,
#                                 HIGH 65 / A+,A,B / 0.5 / 2 / 1c / paper allowed while data is collected)
#MEDIUM_REQUIRE_KNOWN_EV=false   # let MEDIUM paper-trade before history supports an EV estimate
LOW_MIN_SIGNAL_QUALITY=85
MEDIUM_MIN_SIGNAL_QUALITY=75
HIGH_MIN_SIGNAL_QUALITY=65
#LOW_ALLOWED_GRADES=A+,A
#HIGH_ALLOWED_GRADES=A+,A,B,C
#LOW_MIN_STABILITY=0.8
#LOW_MAX_SOFT_FLAGS=0
#LOW_MIN_EV_CENTS=3
#LOW_REQUIRE_KNOWN_EV=true

# Advanced (optional): *_MAX_TOTAL_EXPOSURE_USD, *_MIN_LIQUIDITY_CONTRACTS,
# *_LOSS_COOLDOWN_SEC, *_TRADE_COOLDOWN_SEC, *_MIN_ENTRY_PRICE_CENTS,
# *_MAX_ENTRY_PRICE_CENTS, *_MAX_BALANCE_FRACTION
